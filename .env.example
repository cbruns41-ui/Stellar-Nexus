PORT=3000
# Optional: anderer Speicherort für die SQLite-Datei
# DATABASE_PATH=./data/stellar-nexus.db

# SMTP transport for admin approval mail (no real emails in tests).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PUBLIC_URL=https://your-game.example
# Leer = Node wird direkt erreicht. Hinter Caddy/nginx auf Hetzner:
# TRUST_PROXY=1
TRUST_PROXY=
# Session cookie Secure-Flag. Leer = folgt PUBLIC_URL (https → Secure).
# COOKIE_SECURE=1
# COOKIE_SECURE=0
