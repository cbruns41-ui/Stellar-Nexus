PORT=3000
# Optional: anderer Speicherort für die SQLite-Datei
# DATABASE_PATH=./data/stellar-nexus.db

# SMTP transport for admin approval mail (no real emails in tests).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PUBLIC_URL=https://your-game.example
# Comma-separated trusted proxy IPs/CIDRs. Leave empty for a direct server.
TRUST_PROXY=
